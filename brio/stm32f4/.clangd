# The stm32f4 stratum parses against the STM32F4 project's database:
# headers here include "stm32f4xx.h" and need the arm-none-eabi driver
# and the STM32F429xx device select. Overrides the framework default
# (brio/.clangd, host flags) - the same routing brio/stm32g0/.clangd does
# for its architecture. Path relative to this file.
CompileFlags:
  CompilationDatabase: ../../build-cmake/stm32f429zi-release
