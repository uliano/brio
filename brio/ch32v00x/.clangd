# The ch32v00x stratum parses against the CH32V00x project's database:
# these headers are RV32EC and only that compiler's flags describe them.
# Overrides the framework default (brio/.clangd, host flags). Path
# relative to this file.
CompileFlags:
  CompilationDatabase: ../../build-cmake/ch32v006k8-release
  # clangd's clang knows no WCH extension: the database's -march (the
  # part's full ISA under WCH's gcc, CMakeLists.txt) would make every
  # TU fail to parse, so the editor sees the standard subset instead.
  # The compiler still builds with xw; only the parse is narrowed.
  Remove: [-march=*]
  Add: [-march=rv32ec_zmmul]
