# The ch32x035 stratum parses against the CH32X035 project's database:
# these headers are RV32IMAC and only that compiler's flags describe them.
# Overrides the framework default (brio/.clangd, host flags). Path relative
# to this file.
CompileFlags:
  CompilationDatabase: ../../build-cmake/ch32x035f8-release
  # clangd's clang knows no WCH extension: the database's -march (the
  # part's full ISA under WCH's gcc, CMakeLists.txt) would make every TU
  # fail to parse, so the editor sees the standard subset instead. The
  # compiler still builds with xw; only the parse is narrowed.
  Remove: [-march=*]
  Add: [-march=rv32imac]
