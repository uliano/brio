{
    // --- C/C++: cpptools is the engine in this project (driven by the
    //     PlatformIO-generated c_cpp_properties.json). clangd is turned off
    //     explicitly so the repo does not depend on the machine's global
    //     default (~/projects/c++ is the inverse case: clangd on, cpptools
    //     off). Note: this stops the clangd *server*, not the extension's
    //     activation - PlatformIO's "conflicted extensions" popup checks
    //     activation and may still appear after an extension restart; it is
    //     a false positive, dismiss it with "Remind later". ---
    "clangd.enable": false,

    // --- Host tests (test/test_*/main.cpp) include <doctest.h>, which needs
    //     <ostream>/<signal.h>: absent from the AVR freestanding libstdc++
    //     that the PlatformIO-generated configuration parses with. Kept
    //     out of the IntelliSense index so cpptools never picks a test as
    //     the owning translation unit of a kernel header (the symptom was
    //     "#include errors detected... squiggles disabled" on panic.hpp).
    //     Files stay visible and editable; only IntelliSense skips them.
    //     Native builds are checked by `pio test -e native`, not by the
    //     editor. ---
    "C_Cpp.files.exclude": {
        "test/**": true
    },

    // --- Outline as the bird's-eye view of the file (the breadcrumbs
    //     picker became a collapse-one-node-at-a-time tree): keep the
    //     whole hierarchy expanded, variables included (static members
    //     matter in these monostate headers). ---
    "outline.collapseItems": "alwaysExpand",
    "outline.showVariables": true,

    // Pin the enclosing scopes (namespace/class/function) at the top of
    // the editor while scrolling.
    "editor.stickyScroll.enabled": true
}
