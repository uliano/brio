# clangd config for the host tests: test/ is its OWN CMake project
# (test/CMakeLists.txt), with its own compile_commands.json emitted at
# ../build-cmake/host - point clangd straight at it instead of rewriting
# AVR flags borrowed from the root database (the old approach, needed only
# because there used to be one shared PlatformIO compilation database with
# no native entries of its own).
CompileFlags:
  CompilationDatabase: ../build-cmake/host
