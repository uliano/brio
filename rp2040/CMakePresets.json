{
    "version": 6,
    "configurePresets": [
        {
            "name": "rp2040-release",
            "displayName": "RP2040, 2 MB flash (release, -Os)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/../build-cmake/rp2040-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "RP2040_FLASH_KB": "2048",
                "RP2040_BOOT2": "w25q080"
            }
        },
        {
            "name": "rp2040-debug",
            "displayName": "RP2040, 2 MB flash (debug, -Og)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/../build-cmake/rp2040-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "RP2040_FLASH_KB": "2048",
                "RP2040_BOOT2": "w25q080"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "rp2040-release",
            "configurePreset": "rp2040-release"
        },
        {
            "name": "rp2040-debug",
            "configurePreset": "rp2040-debug"
        }
    ]
}
