# clangd config for this board file: it parses with the ch32v00x
# project's command line for the board type's own preset (the database
# that configure emits), so the target headers it includes resolve as in
# the build. clangd's clang knows no WCH extension, so the database's
# -march is narrowed to the standard subset for the parse alone, as in
# ch32v00x/.clangd.
CompileFlags:
  CompilationDatabase: ../../build-cmake/ch32v006f8-release
  Remove: [-march=*]
  Add: [-march=rv32ec_zmmul]
