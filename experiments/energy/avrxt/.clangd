# clangd config for the AVR half of this experiment: these TUs are
# compiled by the avrxt/ CMake project (its CMakeLists globs
# ../experiments/*/avrxt/*.cpp), so point clangd at that project's
# database - same pattern as avrxt/.clangd, path adjusted for depth.
CompileFlags:
  CompilationDatabase: ../../../build-cmake/avr128db48-release
