# clangd config for the SAM half of this experiment: these TUs are
# compiled by the samc21/ CMake project (its CMakeLists globs
# ../experiments/*/samc21/*.cpp), so point clangd at that project's
# database - same pattern as samc21/.clangd, path adjusted for depth.
CompileFlags:
  CompilationDatabase: ../../../build-cmake/samc21j-release
