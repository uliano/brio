# Claude Code personal settings (per-user, not shared)
.claude/settings.local.json

# Build dir (both CMake projects: the root AVR build and test/) + the app
# roster manifest CMake emits at configure time.
build-cmake/
CMakeUserPresets.json
# cpptools is disabled in favor of clangd (.vscode/settings.json); nothing
# generates this file, kept ignored defensively in case cpptools ever gets
# re-enabled by accident.
.vscode/c_cpp_properties.json
# compile_commands.json is regenerated by CMake on every configure
# (CMAKE_EXPORT_COMPILE_COMMANDS); not committed, no manual step needed.
compile_commands.json

# Python bytecode cache from tools/
__pycache__/
*.pyc

# Vendor datasheets: kept locally, not redistributed.
*.pdf

# Generated analysis plots (regenerable via tools/adc_stat.py).
plots/
*.png

# Captured measurement data (regenerable by re-running the capture firmware/tool).
*.csv

# vendor datasheets: local copies only (see docs/avrdx/vendor/README.md)
docs/*/vendor/*.pdf
docs/*/vendor/extracts/
